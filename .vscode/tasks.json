{
  // Opens a terminal panel that shows analysis progress. Its output also keeps the
  // codespace awake during long runs (terminal output counts as activity).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DeGenRESOLVE run monitor",
      "type": "shell",
      "command": "degenresolve-monitor",
      "isBackground": false,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "showReuseMessage": false,
        "clear": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
