#!/bin/sh
# Fluxbox session start for the DeGenRESOLVE codespace (installed by the image build as
# ~/.fluxbox/startup, which startfluxbox runs when the desktop starts).
#
# DeGenRESOLVE is started from here, not from a devcontainer lifecycle command, because
# processes started by lifecycle commands are stopped when the command finishes. On the
# very first start the launcher waits until the codespace setup (demo data, settings) is done.
xmodmap "$HOME/.Xmodmap" 2>/dev/null
/usr/local/bin/degenresolve-gui --session >>/tmp/degenresolve-gui.log 2>&1 &
exec fluxbox
